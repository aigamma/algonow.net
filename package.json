{
  "name": "algonow",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "algonow.net: Python AI architecture and engineering scenarios, with a preserved legacy algorithm collection.",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prerender.mjs && node scripts/prerender-home.mjs",
    "preview": "vite preview",
    "check": "node scripts/check.mjs && node scripts/check-engineering.mjs && npm test",
    "check:engineering": "node scripts/check-engineering.mjs --include-drafts --run-python",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "narration:plan": "node scripts/narration/generate-puzzle-narration.mjs",
    "narration:test": "node --test tests/narration-adapter.test.mjs tests/narration-plan.test.mjs tests/narration-release.test.mjs tests/preserved-narration-player.test.mjs",
    "narration:generate": "node scripts/narration/generate-puzzle-narration.mjs",
    "narration:authorize": "node scripts/narration/authorize-release-objects.mjs",
    "narration:publish": "node scripts/narration/publish-puzzle-narration.mjs",
    "narration:install": "node scripts/narration/install-puzzle-narration.mjs",
    "narration:verify": "node scripts/narration/verify-puzzle-narration.mjs",
    "verify:solutions": "python scripts/verify_solutions.py"
  },
  "dependencies": {
    "@netlify/blobs": "^8.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "vite": "^5.4.8"
  }
}
